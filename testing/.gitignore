.venv/
playwright/node_modules/
# Raw run output: large and regenerated by every run. The summaries, HTML
# dashboards and JUnit files beside them are what the report cites.
results/**/*.jtl
results/**/*.log
results/playwright-nfr/artifacts/
results/selenium/screenshots/
results/api/**/*.ndjson
.schemathesis/
# JMeter's HTML dashboards are ~113 vendored files each; they are committed as
# results/jmeter/dashboards/<scenario>.zip (unzip and open index.html).
results/jmeter/*/
!results/jmeter/dashboards/
