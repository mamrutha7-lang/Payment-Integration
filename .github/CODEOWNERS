# ---------------------------------------------------------------------------
# The guards that decide what production refuses.
# ---------------------------------------------------------------------------

# `production_boot_failures()` (:1093) is why an ENV=prod host on the repo's
# published AUTH_SECRET never binds a port — that secret signs the reep_session
# cookie, so the alternative is one forged {"role":"DIRECTOR"} cookie away from
# every student's record, with no login and no database row involved.
# `password_login_allowed` (:1016) is an ALLOWLIST of dev/CI environment names,
# not `not is_prod`; flipping it to a denylist opens the password door on every
# ENV nobody anticipated.
apps/api-py/app/config.py               @darshani8

# Session minting and verification: scrypt hashing, the HS256 signing, and the
# token-version revocation check. Everything downstream trusts what these return.
apps/api-py/app/security.py             @darshani8

# The only path that turns a Google identity into a REEP session. It verifies the
# ID token properly — RS256 against Google's JWKS, aud, iss, expiry,
# email_verified, single-use state cookie, nonce — and then refuses any verified
# email with no row in `users`. Nothing self-provisions and no role is guessed;
# each of those checks is load-bearing on its own.
apps/api-py/app/google_auth.py          @darshani8

# Where every request and every WebSocket reads the session it is then trusted on.
